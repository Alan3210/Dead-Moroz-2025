  showTriggerName: Enter
  appearSFX: {fileID: 8300000, guid: 1dd4d7cd08092184c81de8ed1d676d95, type: 3}
  screenOnSFX: {fileID: 8300000, guid: 1bfbc21f35933324ebb7b814bece02d0, type: 3}
  tvAmbienceSFX: {fileID: 8300000, guid: 2d19587cf3313b04eaa04352016c93d9, type: 3}
  tvAmbienceVolume: 1
  tvLiftSFX: {fileID: 8300000, guid: 4aa7885813571cb4f81006cc7cb59363, type: 3}
  tvLowerSFX: {fileID: 8300000, guid: 4aa7885813571cb4f81006cc7cb59363, type: 3}
  screenTurnOnDelay: 5
  textStartDelay: 3
  tvScreenObject: {fileID: 767353075}
  tickerText: {fileID: 1401103576}
  scrollSpeed: 0.7
  newsLines:
  - 
  - "\u0420\u043E\u0441\u0441\u0438\u0439\u0441\u043A\u0430\u044F \u044D\u043A\u043E\u043D\u043E\u043C\u0438\u043A\u0430
    \u0443\u0441\u043F\u0435\u0448\u043D\u043E \u0441\u043F\u0440\u0430\u0432\u043B\u044F\u0435\u0442\u0441\u044F
    \u0441\u043E \u0432\u0441\u0435\u043C\u0438 \u0432\u044B\u0437\u043E\u0432\u0430\u043C\u0438"
  - "\u042D\u043A\u043E\u043D\u043E\u043C\u0438\u043A\u0430 \u0440\u0430\u0432\u043D\u043E\u0432\u0435\u0441\u0438\u044F:
    \u0440\u043E\u0441\u0441\u0438\u044F\u043D\u0435 \u0441\u0442\u0430\u043B\u0438
    \u0436\u0438\u0442\u044C \u0431\u043E\u0433\u0430\u0447\u0435"
  - "\u0411\u0443\u0434\u0443\u0449\u0438\u0439 \u043B\u0443\u0447\u0448\u0435 \u0443\u0445\u043E\u0434\u044F\u0449\u0435\u0433\u043E:
    \u0440\u043E\u0441\u0441\u0438\u044F\u043D\u0435 \u043F\u043E\u0434\u0432\u043E\u0434\u044F\u0442
    \u0438\u0442\u043E\u0433\u0438 2025 \u0433\u043E\u0434\u0430"
  - "\u0411\u043E\u043B\u044C\u0448\u0438\u043D\u0441\u0442\u0432\u043E \u0440\u043E\u0441\u0441\u0438\u044F\u043D
    \u0434\u043E\u0432\u043E\u043B\u044C\u043D\u044B \u0436\u0438\u0437\u043D\u044C\u044E
    \u0438 \u043D\u0430\u0445\u043E\u0434\u044F\u0442\u0441\u044F \u0432 \u0445\u043E\u0440\u043E\u0448\u0435\u043C
    \u043D\u0430\u0441\u0442\u0440\u043E\u0435\u043D\u0438\u0438"
  - "\u0414\u043E\u0445\u043E\u0434\u044B \u043D\u0430\u0438\u043C\u0435\u043D\u0435\u0435
    \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0435\u043D\u043D\u044B\u0445 \u0440\u043E\u0441\u0441\u0438\u044F\u043D
    \u0432\u044B\u0440\u043E\u0441\u043B\u0438 \u043F\u043E\u0447\u0442\u0438 \u043D\u0430
    \u0442\u0440\u0435\u0442\u044C"
  - "\u0420\u043E\u0441\u0441\u0438\u044F \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0435\u0442
    \u0434\u0435\u043C\u043E\u043D\u0441\u0442\u0440\u0438\u0440\u043E\u0432\u0430\u0442\u044C
    \u0441\u0442\u0430\u0431\u0438\u043B\u044C\u043D\u043E\u0435 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0435
    \u043D\u0435\u0441\u043C\u043E\u0442\u0440\u044F \u043D\u0430 \u0432\u043D\u0435\u0448\u043D\u0435\u0435
    \u0434\u0430\u0432\u043B\u0435\u043D\u0438\u0435"
  - "\u0421\u0442\u0440\u0430\u043D\u0430 \u0443\u0441\u0442\u043E\u0439\u0447\u0438\u0432\u043E
    \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u0442 \u043F\u0435\u0440\u0438\u043E\u0434
    \u0442\u0443\u0440\u0431\u0443\u043B\u0435\u043D\u0442\u043D\u043E\u0441\u0442\u0438
    \u0438 \u0441\u043E\u0445\u0440\u0430\u043D\u044F\u0435\u0442 \u0441\u0443\u0432\u0435\u0440\u0435\u043D\u043D\u0443\u044E
    \u044D\u043A\u043E\u043D\u043E\u043C\u0438\u0447\u0435\u0441\u043A\u0443\u044E
    \u043F\u043E\u043B\u0438\u0442\u0438\u043A\u0443"
  - "\u0417\u0430 \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u044C \u043B\u0435\u0442
    \u043E\u0431\u0449\u0435\u0441\u0442\u0432\u043E \u0441\u0442\u0430\u043B\u043E
    \u0431\u043E\u0433\u0430\u0447\u0435, \u0443\u0441\u0442\u043E\u0439\u0447\u0438\u0432\u0435\u0435
    \u0438 \u0443\u0432\u0435\u0440\u0435\u043D\u043D\u0435\u0435 \u0432 \u0437\u0430\u0432\u0442\u0440\u0430\u0448\u043D\u0435\u043C
    \u0434\u043D\u0435"
  - "\u041F\u043E\u043B\u043E\u0432\u0438\u043D\u0430 \u0440\u043E\u0441\u0441\u0438\u044F\u043D
    \u0441\u0447\u0438\u0442\u0430\u0435\u0442 \u0443\u0445\u043E\u0434\u044F\u0449\u0438\u0439
    \u0433\u043E\u0434 \u0445\u043E\u0440\u043E\u0448\u0438\u043C \u0434\u043B\u044F
    \u0441\u0435\u0431\u044F \u0438 \u0441\u0432\u043E\u0435\u0439 \u0441\u0435\u043C\u044C\u0438"
  - "\u041C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u044C\u043D\u043E\u0435 \u0431\u043B\u0430\u0433\u043E\u043F\u043E\u043B\u0443\u0447\u0438\u0435,
    \u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u043D\u0438\u0435 \u0438 \u043A\u0430\u0440\u044C\u0435\u0440\u043D\u044B\u0439
    \u0440\u043E\u0441\u0442 \u0441\u0442\u0430\u043B\u0438 \u043E\u043F\u043E\u0440\u043E\u0439
    \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u0430 \u0436\u0438\u0437\u043D\u0438
    \u0440\u043E\u0441\u0441\u0438\u044F\u043D"
  - "\u0412 2026\u2011\u043C \u0440\u043E\u0441\u0441\u0438\u044F\u043D \u0436\u0434\u0451\u0442
    \u0440\u043E\u0441\u0442 \u0434\u043E\u0445\u043E\u0434\u043E\u0432, \u043F\u043E\u0432\u044B\u0448\u0435\u043D\u0438\u0435
    \u041C\u0420\u041E\u0422 \u0438 \u043D\u043E\u0432\u044B\u0435 \u0441\u043E\u0446\u0438\u0430\u043B\u044C\u043D\u044B\u0435
    \u043B\u044C\u0433\u043E\u0442\u044B"
  - "\xAB\u0412\u0412\u041F \u0420\u043E\u0441\u0441\u0438\u0438 \u0440\u0430\u0441\u0442\u0451\u0442,
    \u0438\u043D\u0444\u043B\u044F\u0446\u0438\u044F \u0441\u043D\u0438\u0436\u0430\u0435\u0442\u0441\u044F,
    \u0431\u0435\u0437\u0440\u0430\u0431\u043E\u0442\u0438\u0446\u0430 \u043E\u0431\u043D\u043E\u0432\u043B\u044F\u0435\u0442
    \u0438\u0441\u0442\u043E\u0440\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u043C\u0438\u043D\u0438\u043C\u0443\u043C"
  - "\u0413\u043E\u0441\u0434\u043E\u043B\u0433 \u0420\u043E\u0441\u0441\u0438\u0438
    \u2014 \u043E\u0434\u0438\u043D \u0438\u0437 \u0441\u0430\u043C\u044B\u0445 \u043D\u0438\u0437\u043A\u0438\u0445
    \u0432 \u043C\u0438\u0440\u0435: \u044D\u043A\u043E\u043D\u043E\u043C\u0438\u043A\u0430
    \u043E\u0441\u0442\u0430\u0451\u0442\u0441\u044F \u043E\u0434\u043D\u043E\u0439
    \u0438\u0437 \u0441\u0430\u043C\u044B\u0445 \u0443\u0441\u0442\u043E\u0439\u0447\u0438\u0432\u044B\u0445"
  - "\u0420\u043E\u0441\u0441\u0438\u044F \u0443\u043A\u0440\u0435\u043F\u043B\u044F\u0435\u0442
    \u043C\u0430\u043A\u0440\u043E\u044D\u043A\u043E\u043D\u043E\u043C\u0438\u0447\u0435\u0441\u043A\u0443\u044E
    \u0441\u0442\u0430\u0431\u0438\u043B\u044C\u043D\u043E\u0441\u0442\u044C \u0438
    \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u0442 \u0433\u043E\u0434 \u0431\u0435\u0437
    \u043A\u0440\u0438\u0437\u0438\u0441\u043E\u0432"
  - "\u041A 2036 \u0433\u043E\u0434\u0443 \u0431\u0435\u0434\u043D\u043E\u0441\u0442\u044C
    \u0432 \u0420\u043E\u0441\u0441\u0438\u0438 \u0441\u043D\u0438\u0437\u0438\u0442\u0441\u044F
    \u0434\u043E \u043C\u0435\u043D\u0435\u0435 5% \u2014 \u043A\u0443\u0440\u0441
    \u043D\u0430 \u0441\u043F\u0440\u0430\u0432\u0435\u0434\u043B\u0438\u0432\u043E\u0441\u0442\u044C
    \u0438 \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u043A\u0443 \u043B\u044E\u0434\u0435\u0439"
  - "\u0420\u043E\u0441\u0441\u0438\u044F \u043F\u043E\u0431\u0435\u0436\u0434\u0430\u0435\u0442
    \u0432 \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u043E\u043D\u043D\u043E\u0439
    \u0432\u043E\u0439\u043D\u0435 \u0438 \u0443\u043A\u0440\u0435\u043F\u043B\u044F\u0435\u0442
    \u043F\u043E\u0437\u0438\u0446\u0438\u0438 \u043D\u0430 \u043C\u0438\u0440\u043E\u0432\u043E\u0439
    \u0430\u0440\u0435\u043D\u0435"
  - "\xAB\u0420\u043E\u0441\u0441\u0438\u044F \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442
    \u0432\u044B\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u0442\u044C \u0441\u0443\u0432\u0435\u0440\u0435\u043D\u043D\u0443\u044E
    \u044D\u043A\u043E\u043D\u043E\u043C\u0438\u0447\u0435\u0441\u043A\u0443\u044E
    \u043F\u043E\u043B\u0438\u0442\u0438\u043A\u0443 \u0432 \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u0430\u0445
    \u0433\u0440\u0430\u0436\u0434\u0430\u043D \u0438 \u0431\u0438\u0437\u043D\u0435\u0441\u0430"
  - "\u0420\u043E\u0441\u0442 \u044D\u043A\u043E\u043D\u043E\u043C\u0438\u043A\u0438
    \u0437\u0430 \u0442\u0440\u0438 \u0433\u043E\u0434\u0430 \u043F\u043E\u0447\u0442\u0438
    10%: \u0420\u043E\u0441\u0441\u0438\u044F \u043E\u0431\u0433\u043E\u043D\u044F\u0435\u0442
    \u0415\u0432\u0440\u043E\u043F\u0443 \u043F\u043E \u0442\u0435\u043C\u043F\u0430\u043C
    \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044F"
  - "81% \u0440\u043E\u0441\u0441\u0438\u044F\u043D \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u044E\u0442
    \u0441\u0435\u0431\u044F \u0441\u0447\u0430\u0441\u0442\u043B\u0438\u0432\u044B\u043C\u0438
    \u2014 \u0438\u043D\u0434\u0435\u043A\u0441 \u0441\u0447\u0430\u0441\u0442\u044C\u044F
    \u0434\u043E\u0441\u0442\u0438\u0433 66 \u043F\u0443\u043D\u043A\u0442\u043E\u0432"
  - "\u0420\u043E\u0441\u0441\u0438\u044F\u043D\u0435 \u043D\u0435 \u0436\u0434\u0443\u0442
    \u043A\u0430\u0442\u0430\u043A\u043B\u0438\u0437\u043C\u043E\u0432 \u0438 \u043A\u0440\u0438\u0437\u0438\u0441\u043E\u0432:
    \u0431\u043E\u043B\u044C\u0448\u0438\u043D\u0441\u0442\u0432\u043E \u0443\u0432\u0435\u0440\u0435\u043D\u043E,
    \u0447\u0442\u043E 2026 \u0433\u043E\u0434 \u0431\u0443\u0434\u0435\u0442 \u0443\u0434\u0430\u0447\u043D\u044B\u043C"
  - '                                 '
